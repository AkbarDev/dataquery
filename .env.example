# ==============================================================================
# DataQuery AI Web - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In Netlify or Vercel, set these in the web dashboard under Environment Variables.

# Application Identity & URLs
NEXT_PUBLIC_APP_NAME="DataQuery AI"
NEXT_PUBLIC_APP_URL="https://dataquery.in"
NEXT_PUBLIC_API_BASE_URL="/api"

# Feature Flags & Mocking
NEXT_PUBLIC_ENABLE_MOCKS="true"

# AI Inference Service (Optional for future external LLM integration like Ollama or vLLM)
NEXT_PUBLIC_LLM_PROVIDER="mock"
NEXT_PUBLIC_LLM_API_ENDPOINT="http://localhost:11434/api/generate"

# Apache Superset Dashboard Embedded Iframe URL (Optional)
NEXT_PUBLIC_SUPERSET_EMBED_URL="https://superset.internal/embedded"
